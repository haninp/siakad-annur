# Dependensi
node_modules/

# Hasil build
dist/
*.tsbuildinfo

# Data — tidak pernah masuk git.
# Basis data, snapshot, dan ekspor berisi data pribadi santri & wali.
# Kecuali skrip seed/simulasi (isinya KARANGAN): `data/*` mengecualikan isi
# direktori tanpa mengecualikan direktori itu sendiri, sehingga `!data/*.ts`
# tetap bisa menyertakan kembali skrip-skrip tersebut.
data/*
!data/.gitkeep
!data/*.ts
!data/*.js

# Kredensial — tidak pernah masuk git.
.env
.env.*
!.env.example
*.pem
*.key
service-account*.json
credentials*.json
token*.json

# Sistem
.DS_Store
Thumbs.db

# Editor
# Setelan pribadi diabaikan, rekomendasi ekstensi dibagikan. Polanya harus
# `.vscode/*`, bukan `.vscode/` — git tidak bisa membatalkan pengabaian berkas
# di dalam direktori yang sudah diabaikan seluruhnya.
.vscode/*
!.vscode/extensions.json
.idea/

# Cache perkakas
.eslintcache
coverage/
.vitest/
